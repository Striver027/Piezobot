# Altium Designer local working files — generated automatically, not part of the
# released design files (see Hardware/README.md).
History/
__Previews/
*.PrjPcbStructure

# Cloud-sync temporary files
*.baiduyun.uploading.cfg

# Local Chinese translation of the READMEs (for review only, not for release)
README.zh-CN.md

# Raw Altium BOM exports (GBK, Chinese) used to build Docs/BOM_*.xlsx — working
# files, not part of the release.
Docs/source/

# --- STM32 firmware (STM32CubeMX + Keil MDK) ---------------------------
# Build outputs are regenerated by every build and embed local absolute
# paths, so they must never be committed. Everything below is regenerable;
# no source file needed to compile is matched by these rules.
firmware/**/MDK-ARM/Piezobot/
firmware/**/Objects/
firmware/**/Listings/
firmware/**/*.o
firmware/**/*.d
firmware/**/*.crf
firmware/**/*.dep
firmware/**/*.lnp
firmware/**/*.sct
firmware/**/*.map
firmware/**/*.lst
firmware/**/*.htm
firmware/**/*.axf
firmware/**/*.iex
firmware/**/*.bak

# Keil per-user window layout (contains the local Windows user name)
firmware/**/*.uvguix.*

# Local editor / tool settings
firmware/**/.vscode/

# Vendor CMSIS libraries that this project does not use (no include path
# and no references); CubeMX re-copies them if the .ioc is regenerated.
firmware/**/Drivers/CMSIS/DSP/
firmware/**/Drivers/CMSIS/NN/
